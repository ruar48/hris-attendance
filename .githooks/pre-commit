#!/bin/sh
# Rebuild Vite assets when frontend files are committed, so Hostinger
# (which only runs composer install) always deploys a fresh public/build.

if git diff --cached --name-only | grep -qE '^(resources/(js|css)/|vite\.config\.ts$|package(-lock)?\.json$)'; then
    echo "pre-commit: building frontend assets..."
    npm run build || { echo "pre-commit: build failed, commit aborted"; exit 1; }
    git add -A public/build
fi
